# spice.pic — the dune-pic prelude (D-0004, D-0019, D-0020).
#
# Wraps the geometry of rpic's std circuits.pic (loaded first, as the
# `circuits` unit) in LABELED blocks with invisible pin markers, so
# that `R1: resistor(A, B, 10k)` names the element (block label =
# refdes) and exposes its pins (`R1.P`, `R1.N`). The extractor reads the
# value/model from the call's own argument (verbatim); every macro also
# draws it, as the FIRST text shape inside its block — the schematic
# shows it, and the extractor falls back on it for a block that has no
# usable call.
#
# Shadowing a std macro hides it from the prelude too, so the shadowed
# symbols draw through rpic 0.16's geometry twins (`__switch`, `__nmos`,
# `__pmos`, `__njfet`, `__pjfet`, like `__resistor` & co.); only
# `battery`, which has no twin, keeps a private copy (`__dn_battery`).
#
# Pins (D-0020; pic labels must start uppercase):
#   two-terminals  P N        (P = first point = first SPICE node:
#                              + of sources, anode of diodes, arrow
#                              tail of current sources)
#   switch (S)     P N Cp Cn  (Cp/Cn = controlling voltage +/-)
#   cswitch (W)    P N
#   vcvs (E),      P N Cp Cn  (four points; gain is the 5th argument)
#   vccs (G)
#   cccs (F),      P N        (value `Vname gain`)
#   ccvs (H)
#   coupling (K)   none       (`K1: coupling(L1, L2, k)`)
#   npn/pnp (Q)    C B E
#   npn4/pnp4 (Q)  C B E S    (S = substrate)
#   nmos/pmos (M)  D G S B    (B drawn tied to S; pmos has S on top)
#   nmos4/pmos4(M) D G S B    (B its own stub)
#   njfet/pjfet(J) D G S
#   opamp (X)      Inp Inm Out (subcircuit pin order)
#   tline (T),     P1 N1 P2 N2 (port 1 +/-, port 2 +/-: card order)
#   ltraline (O)
#
# Display text: every two-terminal element with a value (resistor,
# capacitor, inductor, diode, vsource, acsource, battery, isource,
# cccs, ccvs), the four-point vcvs/vccs and the centered devices (npn,
# pnp, npn4, pnp4, nmos, pmos, nmos4, pmos4, njfet, pjfet, opamp:
# `M1: nmos(At, NMOD W=4u L=1u, "T₁")`) take one optional argument
# after the value/model, a display text drawn INSTEAD of it:
# `V1: vsource(In, (0,0), PULSE(0 5 0 1u 1u 10m 20m), "Vin")` draws
# `Vin` and still emits `V1 In 0 PULSE(0 5 0 1u 1u 10m 20m)`. Empty or
# absent, the value is drawn. (Not for coupling, switches or lines.)
# Plain Unicode reads best for subscripts (`T₁`); rpic's $...$ math
# labels are not rendered on this (rpic-core) path. A block drawing a display carries a `Disp`
# marker, so the extractor never mistakes the display for the value.
#
# Reserved marker labels: `Gnd` (ground block), `At` (anchor of
# centered elements; their value is the 2nd argument, not the 3rd),
# `Mutual` (a coupling block, whose pins are none), `Disp` (see
# above). Pin
# markers are `circle invis rad 0`; the extractor recognizes exactly
# that shape. Net names are plain pic places (`Vout: (2,1)`), not
# prelude macros.
#
# Idiom: a bare block re-places itself at Here, so every block ends
# `] with .<pin> at $1` to stay where its geometry was drawn.
#
# Scratch variables are global in pic; this prelude prefixes its own
# with `dn`.

# --- value label beside a two-terminal body ------------------------------
# $1 from, $2 to, $3 offset from the axis (in), $4 the value, $5 the
# optional display text drawn instead of the value when not empty. The label
# goes ABOVE horizontal-ish elements and LEFT of vertical ones
# (right-justified, so long values never cross the body), whatever the
# drawing direction.
define __dn_val {
  dnax=$1.x; dnay=$1.y; dnbx=$2.x; dnby=$2.y
  dndx=dnbx-dnax; dndy=dnby-dnay; dnl=sqrt(dndx*dndx+dndy*dndy)
  dnpx=0-dndy/dnl; dnpy=dndx/dnl
  if (dnpy < -0.001) || ((dnpy < 0.001) && (dnpx > 0)) then { dnpx=0-dnpx; dnpy=0-dnpy }
  dnmx=(dnax+dnbx)/2+dnpx*$3; dnmy=(dnay+dnby)/2+dnpy*$3
  if "$5" == "" then { __dn_valtext($4) } else { __dn_valtext($5); __dn_disp }
}
# `Disp` marks a block whose drawn text is a display, not the value.
define __dn_disp { Disp: circle invis rad 0 at (dnmx,dnmy) }
# The model/value text of a centered element: $1 the value, $2 the
# optional display (drawn instead when not empty), $3/$4 where, $5 the
# justification (ljust, or empty).
define __dn_label {
  if "$2" == "" then {
    "$1" $5 at ($3,$4)
  } else {
    "$2" $5 at ($3,$4)
    Disp: circle invis rad 0 at ($3,$4)
  }
}
define __dn_valtext {
  if dnpx < -0.5 then {
    "$1" rjust at (dnmx,dnmy)
  } else {
    "$1" at (dnmx,dnmy)
  }
}

# --- two-terminal pin markers --------------------------------------------
define __dn_pn {
  dnqx=$1.x; dnqy=$1.y; dnrx=$2.x; dnry=$2.y
  P: circle invis rad 0 at (dnqx,dnqy)
  N: circle invis rad 0 at (dnrx,dnry)
}

# --- passives --------------------------------------------------------------
define resistor  { [ __dn_val($1,$2,0.2,$3,$4); __resistor($1,$2);  __dn_pn($1,$2) ] with .P at $1 }
define capacitor { [ __dn_val($1,$2,0.25,$3,$4); __capacitor($1,$2); __dn_pn($1,$2) ] with .P at $1 }
define inductor  { [ __dn_val($1,$2,0.25,$3,$4); __inductor($1,$2);  __dn_pn($1,$2) ] with .P at $1 }
define diode     { [ __dn_val($1,$2,0.25,$3,$4); __diode($1,$2);     __dn_pn($1,$2) ] with .P at $1 }

# --- independent sources ---------------------------------------------------
# vsource(P, N, value): circle with -/+; std voltage_source draws its +
# toward its second point, so it gets the points swapped (+ toward P).
define vsource  { [ __dn_val($1,$2,0.3,$3,$4); voltage_source($2,$1); __dn_pn($1,$2) ] with .P at $1 }
# acsource(P, N, value): circle with a sine.
define acsource { [ __dn_val($1,$2,0.3,$3,$4); ac_source($1,$2);      __dn_pn($1,$2) ] with .P at $1 }
# battery(P, N, value): long (+) plate toward P.
define battery  { [ __dn_val($1,$2,0.25,$3,$4); __dn_battery($1,$2);  __dn_pn($1,$2) ] with .P at $1 }
# isource(P, N, value): arrow from P to N (SPICE: current flows from
# n+ through the source into n-).
define isource  { [ __dn_val($1,$2,0.3,$3,$4); current_source($1,$2); __dn_pn($1,$2) ] with .P at $1 }

# std `battery` is a flat statement macro under the same name and, unlike
# switch/nmos/pmos/njfet/pjfet, has no `__battery` twin in rpic 0.16; keep
# its geometry reachable under a private name before shadowing it
# (verbatim from rpic-core 0.16.1 std/circuits.pic, BSD-2-Clause).
define __dn_battery {
  bsx=$1.x; bsy=$1.y; bex=$2.x; bey=$2.y
  bdx=bex-bsx; bdy=bey-bsy; bL=sqrt(bdx*bdx+bdy*bdy)
  bux=bdx/bL; buy=bdy/bL; bpx=0-buy; bpy=bux
  bg=0.07; bM=bL/2; bP=0.16; bN=0.08
  line from (bsx,bsy) to (bsx+bux*(bM-bg/2),bsy+buy*(bM-bg/2))
  line from (bsx+bux*(bM-bg/2)+bpx*bP,bsy+buy*(bM-bg/2)+bpy*bP) \
    to   (bsx+bux*(bM-bg/2)-bpx*bP,bsy+buy*(bM-bg/2)-bpy*bP)
  line from (bsx+bux*(bM+bg/2)+bpx*bN,bsy+buy*(bM+bg/2)+bpy*bN) \
    to   (bsx+bux*(bM+bg/2)-bpx*bN,bsy+buy*(bM+bg/2)-bpy*bN)
  line from (bsx+bux*(bM+bg/2),bsy+buy*(bM+bg/2)) to (bex,bey)
}

# --- controlled sources (D-0026) ---------------------------------------------
# The diamond of std vsource_ctrl/isource_ctrl, oriented like vsource
# (+ toward P) and isource (arrow from P to N).
#
# vcvs(P, N, Cp, Cn, gain) -> E, vccs(P, N, Cp, Cn, gain) -> G: four
# points, card order `E1 P N Cp Cn gain`. The controlling pair is drawn
# at Cp and Cn as two small open terminals (the switch's convention,
# D-0020), each with a short stub aimed at the diamond and its sign
# (+ at Cp, - at Cn) on the outside; place them beside the body (the
# textbook layout is left of a vertical source) and wire to them. The
# gain goes on the side of the body away from the controlling pair.
define __dn_ctl_stub {
  # $1/$2 terminal x/y; $3 = 1 for +, 0 for -; $4/$5 unit vector away
  # from the other terminal. Uses dnmx/dnmy (diamond center) and
  # dnnx/dnny (unit normal of the body axis). The stub runs square to
  # the body, toward it, and stops short of the diamond; a terminal
  # that is not beside the body aims at its center instead.
  dnsx=dnmx-($1); dnsy=dnmy-($2)
  dnsn=dnsx*dnnx+dnsy*dnny
  if (dnsn > 0.3) || (dnsn < -0.3) then {
    dnsl=dnsn; if dnsl < 0 then { dnsl=0-dnsl }
    dnsx=dnnx*dnsn; dnsy=dnny*dnsn
  } else {
    dnsl=sqrt(dnsx*dnsx+dnsy*dnsy)
  }
  dnsk=0.2; if dnsl-0.3 < dnsk then { dnsk=dnsl-0.3 }
  circle rad 0.03 at ($1,$2)
  if dnsk > 0.04 then {
    dnsx=dnsx/dnsl; dnsy=dnsy/dnsl
    line from ($1+dnsx*0.03,$2+dnsy*0.03) to ($1+dnsx*dnsk,$2+dnsy*dnsk)
    dnsgx=$1+dnsx*dnsk*0.6+($4)*0.1; dnsgy=$2+dnsy*dnsk*0.6+($5)*0.1
  } else {
    dnsgx=$1+($4)*0.12; dnsgy=$2+($5)*0.12
  }
  if $3 == 1 then { "+" at (dnsgx,dnsgy) } else { "−" at (dnsgx,dnsgy) }
}
define __dn_dep4 {
  # $1 P, $2 N, $3 Cp, $4 Cn, $5 gain, $6 = 0 vcvs / 1 vccs, $7 the
  # optional display text.
  dnax=$1.x; dnay=$1.y; dnbx=$2.x; dnby=$2.y
  dncpx=$3.x; dncpy=$3.y; dncnx=$4.x; dncny=$4.y
  dndx=dnbx-dnax; dndy=dnby-dnay; dnl=sqrt(dndx*dndx+dndy*dndy)
  dnpx=0-dndy/dnl; dnpy=dndx/dnl; dnnx=dnpx; dnny=dnpy
  dnmx=(dnax+dnbx)/2; dnmy=(dnay+dnby)/2
  # The gain: on the far side from the controlling pair.
  dnside=((dncpx+dncnx)/2-dnmx)*dnpx+((dncpy+dncny)/2-dnmy)*dnpy
  if dnside > 0 then { dnpx=0-dnpx; dnpy=0-dnpy }
  dntx=dnmx+dnpx*0.32; dnty=dnmy+dnpy*0.32
  if "$7" == "" then { __dn_gaintext($5) } else { __dn_gaintext($7); __dn_disp }
  if $6 == 0 then { vsource_ctrl($2,$1) } else { isource_ctrl($1,$2) }
  __dn_pn($1,$2)
  # Each sign sits away from the other terminal.
  dnux=dncpx-dncnx; dnuy=dncpy-dncny; dnul=sqrt(dnux*dnux+dnuy*dnuy)
  if dnul < 0.001 then { dnux=0; dnuy=1; dnul=1 }
  dnux=dnux/dnul; dnuy=dnuy/dnul
  __dn_ctl_stub(dncpx,dncpy,1,dnux,dnuy)
  __dn_ctl_stub(dncnx,dncny,0,0-dnux,0-dnuy)
  Cp: circle invis rad 0 at (dncpx,dncpy)
  Cn: circle invis rad 0 at (dncnx,dncny)
}
define __dn_gaintext {
  if dnpx > 0.5 then {
    "$1" ljust at (dntx,dnty)
  } else { if dnpx < -0.5 then {
    "$1" rjust at (dntx,dnty)
  } else {
    "$1" at (dntx,dnty)
  } }
}
define vcvs { [ __dn_dep4($1,$2,$3,$4,$5,0,$6) ] with .P at $1 }
define vccs { [ __dn_dep4($1,$2,$3,$4,$5,1,$6) ] with .P at $1 }
# cccs(P, N, Vname gain) -> F, ccvs(P, N, Vname gain) -> H: two points;
# the controlling branch is the current through voltage source Vname,
# named in the value exactly as the card wants it.
define cccs { [ __dn_val($1,$2,0.32,$3,$4); isource_ctrl($1,$2);   __dn_pn($1,$2) ] with .P at $1 }
define ccvs { [ __dn_val($1,$2,0.32,$3,$4); vsource_ctrl($2,$1);   __dn_pn($1,$2) ] with .P at $1 }

# --- mutual inductance (K) -----------------------------------------------------
# K1: coupling(L1, L2, k): no pins; the arguments are the two inductor
# refdes (drawn earlier in the figure) and the coefficient, emitted as
# `K1 L1 L2 k`. Drawn as a double-headed arch between the middles of
# the two coils, raised clear of their value labels and labeled `k=...`
# (above a side-by-side pair). The `Mutual` marker tells the extractor
# this block is a coupling.
define coupling {
  [ dnax=(($1.P.x)+($1.N.x))/2; dnay=(($1.P.y)+($1.N.y))/2
    dnbx=(($2.P.x)+($2.N.x))/2; dnby=(($2.P.y)+($2.N.y))/2
    dndx=dnbx-dnax; dndy=dnby-dnay; dnl=sqrt(dndx*dndx+dndy*dndy)
    if dnl < 0.001 then { dnl=0.001; dndx=0.001 }
    dnux=dndx/dnl; dnuy=dndy/dnl; dnpx=0-dnuy; dnpy=dnux
    if (dnpy < -0.001) || ((dnpy < 0.001) && (dnpx > 0)) then { dnpx=0-dnpx; dnpy=0-dnpy }
    dnmx=(dnax+dnbx)/2; dnmy=(dnay+dnby)/2
    dne=0.22; if dnl*0.3 < dne then { dne=dnl*0.3 }
    # (justified away from the arch when it bows sideways)
    if dnpx < -0.5 then {
      "k=$3" rjust at (dnmx+dnpx*0.47,dnmy+dnpy*0.47)
    } else { if dnpx > 0.5 then {
      "k=$3" ljust at (dnmx+dnpx*0.47,dnmy+dnpy*0.47)
    } else {
      "k=$3" at (dnmx+dnpx*0.5,dnmy+dnpy*0.5)
    } }
    spline <-> from (dnax+dnux*dne+dnpx*0.16,dnay+dnuy*dne+dnpy*0.16) \
      to (dnmx+dnpx*0.42,dnmy+dnpy*0.42) \
      to (dnbx-dnux*dne+dnpx*0.16,dnby-dnuy*dne+dnpy*0.16)
    Mutual: circle invis rad 0 at (dnmx,dnmy)
  ] with .Mutual at ((($1.P.x)+($1.N.x)+($2.P.x)+($2.N.x))/4,(($1.P.y)+($1.N.y)+($2.P.y)+($2.N.y))/4)
}

# --- switches --------------------------------------------------------------
# switch(P, N, model): voltage-controlled (S card). The control pins sit
# left of the P -> N direction: Cp/Cn are small open terminals 0.45 in
# off the contact, joined to the lever by a dashed link; the model text
# goes on the opposite side. (The text comes after the geometry here;
# the geometry has no text of its own, so it is still the first.)
define __dn_switch {
  dnax=$1.x; dnay=$1.y; dnbx=$2.x; dnby=$2.y
  dndx=dnbx-dnax; dndy=dnby-dnay; dnl=sqrt(dndx*dndx+dndy*dndy)
  dnux=dndx/dnl; dnuy=dndy/dnl; dnpx=0-dnuy; dnpy=dnux
  dnmx=(dnax+dnbx)/2; dnmy=(dnay+dnby)/2
  __switch($1,$2)
}
define switch {
  [ __dn_switch($1,$2)
    "$3" at (dnmx-dnpx*0.25,dnmy-dnpy*0.25)
    __dn_pn($1,$2)
    line dashed from (dnmx+dnpx*0.12,dnmy+dnpy*0.12) to (dnmx+dnpx*0.36,dnmy+dnpy*0.36)
    line from (dnmx+dnpx*0.36-dnux*0.15,dnmy+dnpy*0.36-dnuy*0.15) \
      to (dnmx+dnpx*0.36+dnux*0.15,dnmy+dnpy*0.36+dnuy*0.15)
    circle rad 0.03 at (dnmx+dnpx*0.45-dnux*0.15,dnmy+dnpy*0.45-dnuy*0.15)
    circle rad 0.03 at (dnmx+dnpx*0.45+dnux*0.15,dnmy+dnpy*0.45+dnuy*0.15)
    Cp: circle invis rad 0 at (dnmx+dnpx*0.45-dnux*0.15,dnmy+dnpy*0.45-dnuy*0.15)
    Cn: circle invis rad 0 at (dnmx+dnpx*0.45+dnux*0.15,dnmy+dnpy*0.45+dnuy*0.15)
  ] with .P at $1
}
# cswitch(P, N, Vctl model): current-controlled (W card); the value text
# names the controlling voltage source and the model.
define cswitch { [ __dn_val($1,$2,0.3,$3); __dn_switch($1,$2); __dn_pn($1,$2) ] with .P at $1 }

# --- transistors (centered at $1, std orientation) -----------------------
# npn(C, model) / pnp(C, model): base left, collector up.
define __dn_bjt {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($3,$4,dncx+0.36,dncy,ljust)
    __bjt((dncx,dncy), 1, 1, $2)
    B: circle invis rad 0 at (gBase_x,gBase_y)
    C: circle invis rad 0 at (gColl_x,gColl_y)
    E: circle invis rad 0 at (gEmit_x,gEmit_y)
  ] with .At at $1
}
define npn { __dn_bjt($1, 0, $2, $3) }
define pnp { __dn_bjt($1, 1, $2, $3) }
# npn4(C, model) / pnp4(C, model): the same symbols plus the substrate
# (S) as a stub leaving the envelope on the collector side, to the
# right, above the model text. Card order `Q1 C B E S model`.
define __dn_bjt4 {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($3,$4,dncx+0.36,dncy-0.04,ljust)
    __bjt((dncx,dncy), 1, 1, $2)
    line from (dncx+0.2236,dncy+0.2) to (dncx+0.5,dncy+0.2)
    B: circle invis rad 0 at (gBase_x,gBase_y)
    C: circle invis rad 0 at (gColl_x,gColl_y)
    E: circle invis rad 0 at (gEmit_x,gEmit_y)
    S: circle invis rad 0 at (dncx+0.5,dncy+0.2)
  ] with .At at $1
}
define npn4 { __dn_bjt4($1, 0, $2, $3) }
define pnp4 { __dn_bjt4($1, 1, $2, $3) }

# nmos(C, model): gate left, drain up, source down; pmos(C, model):
# gate left, source up, drain down. The body (B) is drawn tied to the
# source in both.
define __dn_mos_pins {
  D: circle invis rad 0 at (gDrain_x,gDrain_y)
  G: circle invis rad 0 at (gGate_x,gGate_y)
  S: circle invis rad 0 at (gSrc_x,gSrc_y)
}
define nmos {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy,ljust)
    __nmos((dncx,dncy)); __dn_mos_pins
    B: circle invis rad 0 at (gSrc_x,gSrc_y)
  ] with .At at $1
}
define pmos {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy,ljust)
    __pmos((dncx,dncy))
    # std pmos ties the body to its TOP lead (named gDrain there): that
    # lead is the source of the drawn symbol, as in a CMOS pull-up.
    S: circle invis rad 0 at (gDrain_x,gDrain_y)
    G: circle invis rad 0 at (gGate_x,gGate_y)
    D: circle invis rad 0 at (gSrc_x,gSrc_y)
    B: circle invis rad 0 at (gDrain_x,gDrain_y)
  ] with .At at $1
}
# nmos4(C, model) / pmos4(C, model): the same symbols with the body as
# its own pin, a stub 0.24 in right of the D/S leads (B); nothing ties
# it to the source. The model text moves up, clear of the stub.
define nmos4 {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy+0.24,ljust)
    __dn_mos4_geom((dncx,dncy))
    arrow from (dncx+0.16,dncy) to (dncx-0.08,dncy)
    __dn_mos_pins
    B: circle invis rad 0 at (dncx+0.4,dncy)
  ] with .At at $1
}
define pmos4 {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy+0.24,ljust)
    __dn_mos4_geom((dncx,dncy))
    arrow from (dncx-0.08,dncy) to (dncx+0.16,dncy)
    S: circle invis rad 0 at (gDrain_x,gDrain_y)
    G: circle invis rad 0 at (gGate_x,gGate_y)
    D: circle invis rad 0 at (gSrc_x,gSrc_y)
    B: circle invis rad 0 at (dncx+0.4,dncy)
  ] with .At at $1
}
# The nmos/pmos geometry without the body-to-source tie and the body
# arrow (the caller draws it), plus the bulk lead out to the right.
define __dn_mos4_geom {
  mx=$1.x; my=$1.y
  line from (mx-0.4,my) to (mx-0.2,my)
  line from (mx-0.2,my-0.18) to (mx-0.2,my+0.18)
  line from (mx-0.08,my+0.07) to (mx-0.08,my+0.18)
  line from (mx-0.08,my-0.055) to (mx-0.08,my+0.055)
  line from (mx-0.08,my-0.18) to (mx-0.08,my-0.07)
  line from (mx-0.08,my+0.125) to (mx+0.16,my+0.125)
  line from (mx+0.16,my+0.125) to (mx+0.16,my+0.36)
  line from (mx-0.08,my-0.125) to (mx+0.16,my-0.125)
  line from (mx+0.16,my-0.125) to (mx+0.16,my-0.36)
  line from (mx+0.16,my) to (mx+0.4,my)
  gGate_x=mx-0.4; gGate_y=my; gDrain_x=mx+0.16; gDrain_y=my+0.36; gSrc_x=mx+0.16; gSrc_y=my-0.36
}

# njfet(C, model) / pjfet(C, model): gate left, drain up.
define njfet {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy,ljust)
    __njfet((dncx,dncy)); __dn_mos_pins
  ] with .At at $1
}
define pjfet {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx+0.26,dncy,ljust)
    __pjfet((dncx,dncy)); __dn_mos_pins
  ] with .At at $1
}

# --- op-amp as a subcircuit instance (X card) ----------------------------
# opamp(C, subckt): inverting input on top; pins Inp Inm Out in the
# order the X card lists them (`.subckt NAME inp inm out`).
define opamp {
  [ dncx=$1.x; dncy=$1.y
    At: circle invis rad 0 at (dncx,dncy)
    __dn_label($2,$3,dncx,dncy-0.5,)
    __opamp((dncx,dncy), 1)
    Inp: circle invis rad 0 at (gIp_x,gIp_y)
    Inm: circle invis rad 0 at (gIm_x,gIm_y)
    Out: circle invis rad 0 at (gY_x,gY_y)
  ] with .At at $1
}

# --- transmission lines (T, O) -------------------------------------------
# tline(P1, P2, params) / ltraline(P1, P2, model): the coax symbol (the
# stadium of std `tline`) from P1 to P2 is the signal conductor; each
# port's return conductor leaves the shell near its end and ends 0.4 in
# to the right of the P1 -> P2 direction (below a left-to-right line).
# Pins in card order: P1 N1 P2 N2 (`T1 P1 N1 P2 N2 Z0=50 TD=1n`,
# `O1 P1 N1 P2 N2 LMOD`). The body is 0.8 in long, less on a short line.
define __dn_tline {
  dnax=$1.x; dnay=$1.y; dnbx=$2.x; dnby=$2.y
  dndx=dnbx-dnax; dndy=dnby-dnay; dnl=sqrt(dndx*dndx+dndy*dndy)
  dnux=dndx/dnl; dnuy=dndy/dnl; dnpx=0-dnuy; dnpy=dnux
  dntb=0.8; if dnl < 1.2 then { dntb=dnl-0.4 }
  dnt0=(dnl-dntb)/2; dnt1=dnt0+dntb; dnth=0.12; dnr=0.4; dnri=0.12
  line from (dnax,dnay) to (dnax+dnux*dnt0,dnay+dnuy*dnt0)
  spline from (dnax+dnux*dnt0+dnpx*dnth,dnay+dnuy*dnt0+dnpy*dnth) \
    to (dnax+dnux*(dnt0-dnth*0.7)+dnpx*dnth,dnay+dnuy*(dnt0-dnth*0.7)+dnpy*dnth) \
    to (dnax+dnux*(dnt0-dnth*0.7)-dnpx*dnth,dnay+dnuy*(dnt0-dnth*0.7)-dnpy*dnth) \
    to (dnax+dnux*dnt0-dnpx*dnth,dnay+dnuy*dnt0-dnpy*dnth)
  line from (dnax+dnux*dnt0+dnpx*dnth,dnay+dnuy*dnt0+dnpy*dnth) \
    to (dnax+dnux*dnt1+dnpx*dnth,dnay+dnuy*dnt1+dnpy*dnth)
  line from (dnax+dnux*dnt0-dnpx*dnth,dnay+dnuy*dnt0-dnpy*dnth) \
    to (dnax+dnux*dnt1-dnpx*dnth,dnay+dnuy*dnt1-dnpy*dnth)
  spline from (dnax+dnux*dnt1+dnpx*dnth,dnay+dnuy*dnt1+dnpy*dnth) \
    to (dnax+dnux*(dnt1+dnth*0.7)+dnpx*dnth,dnay+dnuy*(dnt1+dnth*0.7)+dnpy*dnth) \
    to (dnax+dnux*(dnt1+dnth*0.7)-dnpx*dnth,dnay+dnuy*(dnt1+dnth*0.7)-dnpy*dnth) \
    to (dnax+dnux*dnt1-dnpx*dnth,dnay+dnuy*dnt1-dnpy*dnth)
  line from (dnax+dnux*dnt1,dnay+dnuy*dnt1) to (dnbx,dnby)
  line from (dnax+dnux*(dnt0+dnri)-dnpx*dnth,dnay+dnuy*(dnt0+dnri)-dnpy*dnth) \
    to (dnax+dnux*(dnt0+dnri)-dnpx*dnr,dnay+dnuy*(dnt0+dnri)-dnpy*dnr)
  line from (dnax+dnux*(dnt1-dnri)-dnpx*dnth,dnay+dnuy*(dnt1-dnri)-dnpy*dnth) \
    to (dnax+dnux*(dnt1-dnri)-dnpx*dnr,dnay+dnuy*(dnt1-dnri)-dnpy*dnr)
  P1: circle invis rad 0 at (dnax,dnay)
  N1: circle invis rad 0 at (dnax+dnux*(dnt0+dnri)-dnpx*dnr,dnay+dnuy*(dnt0+dnri)-dnpy*dnr)
  P2: circle invis rad 0 at (dnbx,dnby)
  N2: circle invis rad 0 at (dnax+dnux*(dnt1-dnri)-dnpx*dnr,dnay+dnuy*(dnt1-dnri)-dnpy*dnr)
}
define tline    { [ __dn_val($1,$2,0.3,$3); __dn_tline($1,$2) ] with .P1 at $1 }
define ltraline { [ __dn_val($1,$2,0.3,$3); __dn_tline($1,$2) ] with .P1 at $1 }

# --- ground -------------------------------------------------------------------
# ground(P): node 0 at P (symbol hangs below P).
define ground { [ dnqx=$1.x; dnqy=$1.y; __ground((dnqx,dnqy)); Gnd: circle invis rad 0 at (dnqx,dnqy) ] with .Gnd at $1 }

# --- rendering ---------------------------------------------------------------
# rpic estimates text extents, and value labels often sit on the outer
# edge of a figure; a small canvas margin keeps them uncropped. A figure
# can set its own `margin`.
margin = 0.1
