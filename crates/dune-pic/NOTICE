  crates/dune-core/src/measure.rs, crates/dune-netlist/src/meas.rs,
  crates/dune-cli/src/measure.rs (`.measure`)
      frontend/com_measure2.c ("Patches by Bill Swartz from 2009-05-18
      and 2009-08-21 are included"), frontend/measure.c,
      maths/misc/equality.c ("Copyright 1991 Regents of the University
      of California"; after Bruce Dawson, "Comparing floating point
      numbers").

  crates/dune-core/src/switch.rs
      spicelib/devices/sw/swload.c, spicelib/devices/csw/cswload.c
      ("Copyright 1990 Regents of the University of California.
      Author: 1985 Gordon Jacobs. Modified: 2001 Jon Engelbert"),
      spicelib/devices/sw/swtrunc.c.

  crates/dune-core/src/vdmos/ (mod.rs, load.rs, model.rs)
      VDMOS power MOSFET model - spicelib/devices/vdmos/: vdmosload.c,
