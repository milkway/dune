```{r, include = FALSE}
knitr::opts_chunk$set(
  collapse = TRUE, comment = "#>",
  fig.path = "figures/amplifier-", fig.width = 6.5, fig.height = 3.6, dpi = 110,
  fig.alt = "Plot of the simulation result described in the text."
)
library(ggplot2)
theme_set(theme_minimal(base_size = 11))
